{
  "name": "gospel-analogies-scavenger-hunt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "release:pages": "node --env-file=.env.production scripts/release-worker.mjs publish",
    "test:live-photo": "playwright test -c playwright.live.config.ts",
    "release:worker": "node --env-file=.env.production scripts/release-worker.mjs deploy",
    "verify:worker": "node --env-file=.env.production scripts/release-worker.mjs verify",
    "test:e2e": "npm run build && playwright test",
    "build:review": "tsc -p worker/tsconfig.json && cd worker && wrangler deploy --dry-run --outdir ../.wrangler/review-build",
    "test:review-api": "npm run build:review && node --test tests-api/*.test.mjs",
    "test:review": "npm run build:review && VITE_REVIEW_API_URL=http://127.0.0.1:8788 npm run build && playwright test --config playwright.review.config.ts"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
